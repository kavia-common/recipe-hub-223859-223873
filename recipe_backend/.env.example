# Database (preferred single-DSN)
POSTGRES_URL=postgresql://appuser:dbpass@localhost:5000/myapp

# Or individual parts (host optional, defaults to localhost)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbpass
POSTGRES_DB=myapp
POSTGRES_PORT=5000
POSTGRES_HOST=localhost

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=10080
